<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E17">

    <!-- ══ TOP HEADER BAR ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#121824"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 DMS MeshNet"
                android:textSize="20sp"
                android:textColor="#00F2FE"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_user_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 My Node: Active"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE MESH"
            android:textColor="#00FF87"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#1A2638"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <!-- ══ RELAY ROUTER CARD (Compact & Sleek) ═════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/radar_card_bg"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Background Mesh Relay"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_router_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Router Mode: OFF"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_router"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp" />

    </LinearLayout>

    <!-- ══ CENTER CIRCULAR RADAR SCANNING SECTION ══════════════════ -->
    <!-- Takes full available space and centers the circular radar button vertically -->
    <LinearLayout
        android:id="@+id/layout_radar_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- Circular Radar Container -->
        <RelativeLayout
            android:id="@+id/radar_container"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:gravity="center">

            <!-- Outer Radar Glow Wave Ring -->
            <View
                android:id="@+id/radar_ring_outer"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_centerInParent="true"
                android:background="@drawable/glow_circle_outer" />

            <!-- Middle Radar Glow Wave Ring -->
            <View
                android:id="@+id/radar_ring_inner"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_centerInParent="true"
                android:background="@drawable/glow_circle_inner" />

            <!-- CENTER CIRCULAR BUTTON (Slightly larger: 145dp x 145dp) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_discover"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_centerInParent="true"
                android:background="@drawable/circle_radar_button"
                android:text="📡\nSCAN"
                android:textColor="#00F2FE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:gravity="center"
                android:elevation="8dp"
                android:stateListAnimator="@null" />

        </RelativeLayout>

        <!-- Status Text directly under circular button -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Radar to Scan Nearby Nodes"
            android:textColor="#00FF87"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </LinearLayout>

    <!-- ══ AVAILABLE PEERS SECTION (HIDDEN initially, appears ONLY when peers are found!) ══ -->
    <LinearLayout
        android:id="@+id/card_peers"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:orientation="vertical"
        android:background="@drawable/radar_card_bg"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DISCOVERED PEERS"
                android:textColor="#4FACFE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_peer_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Nodes"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2E45"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/list_peers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#1A283E"
            android:dividerHeight="1dp" />

    </LinearLayout>

</LinearLayout>
