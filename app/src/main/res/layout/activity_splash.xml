<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Outer Glow Circle -->
    <View
        android:id="@+id/glow_outer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/glow_circle_outer" />

    <!-- Inner Glow Circle -->
    <View
        android:id="@+id/glow_inner"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_centerInParent="true"
        android:background="@drawable/glow_circle_inner" />

    <!-- Logo Circle Container -->
    <LinearLayout
        android:id="@+id/logo_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerInParent="true"
        android:background="@drawable/logo_bg"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="44sp" />

    </LinearLayout>

    <!-- App Name: DMS -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/logo_container"
        android:layout_marginTop="28dp"
        android:text="DMS"
        android:textColor="#00F2FE"
        android:textSize="50sp"
        android:textStyle="bold"
        android:letterSpacing="0.3" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_app_name"
        android:layout_marginTop="6dp"
        android:text="Decentralized Mesh System"
        android:textColor="#8B949E"
        android:textSize="13sp" />

    <!-- Status Message -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_tagline"
        android:layout_marginTop="56dp"
        android:text="Initializing secure channel..."
        android:textColor="#00FF87"
        android:textSize="12sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="200dp"
        android:layout_height="4dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_status"
        android:layout_marginTop="14dp"
        android:progressDrawable="@drawable/progress_custom"
        android:progress="0"
        android:max="100" />

    <!-- Version Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="28dp"
        android:text="v1.0  |  Buddha Institute of Technology"
        android:textColor="#33FFFFFF"
        android:textSize="10sp" />

</RelativeLayout>
